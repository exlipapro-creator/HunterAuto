# ============================================================
# Hunter Autoworks — The Car Lab
# Environment configuration (variable names only — never commit real secrets)
# ============================================================

# ---- Supabase: PUBLIC configuration (safe for the browser bundle) ----
VITE_SUPABASE_URL="https://nnhdgeuvcpltszgmijml.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# ---- Supabase: SERVER-ONLY configuration (NEVER expose to the browser) ----
SUPABASE_URL="https://nnhdgeuvcpltszgmijml.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Server-side routing (/api/v1/directions) — SERVER-ONLY, never VITE_* ----
# Base URL of the OSRM routing service used by GET /api/v1/directions.
# The destination is server-authoritative (src/lib/hunterLocation.ts); the
# browser never contacts the routing provider directly.
#
# PRODUCTION: must point at an approved production OSRM deployment (preferred:
# a self-hosted OSRM container on Render loaded with a Tanzania OSM extract),
# e.g. OSRM_BASE_URL="https://osrm-<your-service>.onrender.com"
# The public demo server (router.project-osrm.org) is REFUSED in production —
# the server fails closed with ROUTING_NOT_CONFIGURED rather than silently
# depending on a best-effort public demo.
#
# DEVELOPMENT: you may run a local OSRM (e.g. via Docker with a small extract)
# or, ONLY for local testing, the public demo server.
OSRM_BASE_URL=""

# ---- Runtime ----
NODE_ENV="development"
